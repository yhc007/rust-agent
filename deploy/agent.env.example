# rust-agent daemon environment file.
#
# Install location: ~/.config/polymarket-btc/agent.env (mode 600).
# Loaded by rust-agent-daemon.service via EnvironmentFile=.
#
# Every value here is a real secret in production — never commit a
# filled-in copy to git, never paste it into chat tools, and never copy
# it to a shared workspace. Restrict the file to your user:
#   chmod 600 ~/.config/polymarket-btc/agent.env

# ---- LLM credentials ----
# Pick whichever backends your daemon's --llms list uses. Unused keys
# can stay commented out — load_preset_config only reads what the
# preset asks for.

# DeepSeek (default single-LLM path).
#DEEPSEEK_API_KEY=sk-...
#DEEPSEEK_MODEL=deepseek-chat

# Anthropic (Claude).
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / OpenAI-compatible (vLLM, etc.).
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o

# ---- Polymarket CLOB credentials ----
# Required for the user-channel WS listener (fill events) and for live
# order submission. Run `rust-agent clob-auth` once per wallet to mint
# the trio. Daemon spawns the WS listener iff all three are set.
#POLYMARKET_CLOB_API_KEY=...
#POLYMARKET_CLOB_SECRET=...
#POLYMARKET_CLOB_PASSPHRASE=...

# Apply WS-observed fills back into the orders / positions_v2 tables.
# Leave unset (or =0) for an observation-only listener.
#APPLY_FILLS=1

# ---- Live trading (defense-in-depth) ----
# All of these must be true for an order to actually hit Polymarket:
#   1. POLYMARKET_PRIVATE_KEY exported, wallet funded with USDC on Polygon.
#   2. `rust-agent clob-auth` run once; CLOB creds above are set.
#   3. `rust-agent usdc-approve --rpc-url … --send` run once on the wallet.
#   4. LIVE_TRADING_ENABLED=1 (this file).
#   5. `--live` flag added to ExecStart in rust-agent-daemon.service.
#   6. Risk gate (RISK_MAX_ORDER_USD) lets the order through; no ./KILL
#      file present.
# Drop any one and the system stays on paper.
#POLYMARKET_PRIVATE_KEY=0x...
#LIVE_TRADING_ENABLED=1

# ---- Risk gate ----
# Hard cap on per-order USD size (default $50). Lower this when you
# first switch to live. Kill switch path is checked before every order
# — `touch ~/workHard/KILL` to immediately halt all order routing.
#RISK_MAX_ORDER_USD=50
#RISK_KILL_PATH=/home/paul/workHard/KILL

# ---- pdf-kg integration ----
# Set to `disabled` to skip pdf-kg tool registration when that backend
# isn't reachable. Otherwise points at the backend HTTP base URL.
#PDFKG_BACKEND_URL=disabled
