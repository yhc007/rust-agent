# rust-agent daemon environment file.
#
# Install location: ~/.config/polymarket-btc/agent.env (mode 600).
# Loaded by rust-agent-daemon.service via EnvironmentFile=.
#
# Every value here is a real secret in production — never commit a
# filled-in copy to git, never paste it into chat tools, and never copy
# it to a shared workspace. Restrict the file to your user:
#   chmod 600 ~/.config/polymarket-btc/agent.env

# ---- CoreDB endpoint ----
# Every rust-agent subcommand that takes --coredb-uri honors this
# env var as its default (CLI flag still overrides). Set once
# here and every operator-driven invocation — backtest, stats,
# compare-pnl, dashboard, daemon, settle-pnl, drop-legacy-positions,
# user-channel, *-history — talks to the right CoreDB without an
# arg per command.
#COREDB_URI=127.0.0.1:9042

# ---- LLM credentials ----
# Pick whichever backends your daemon's --llms list uses. Unused keys
# can stay commented out — load_preset_config only reads what the
# preset asks for.

# DeepSeek (default single-LLM path).
#DEEPSEEK_API_KEY=sk-...
#DEEPSEEK_MODEL=deepseek-chat

# Anthropic (Claude).
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / OpenAI-compatible (vLLM, etc.).
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o

# ---- Polymarket CLOB credentials ----
# Required for the user-channel WS listener (fill events) and for live
# order submission. Run `rust-agent clob-auth` once per wallet to mint
# the trio. Daemon spawns the WS listener iff all three are set.
#POLYMARKET_CLOB_API_KEY=...
#POLYMARKET_CLOB_SECRET=...
#POLYMARKET_CLOB_PASSPHRASE=...

# Apply WS-observed fills back into the orders / positions_v2 tables.
# Leave unset (or =0) for an observation-only listener.
#APPLY_FILLS=1

# ---- Live trading (defense-in-depth) ----
# All of these must be true for an order to actually hit Polymarket:
#   1. POLYMARKET_PRIVATE_KEY exported, wallet funded with USDC on Polygon.
#   2. `rust-agent clob-auth` run once; CLOB creds above are set.
#   3. `rust-agent usdc-approve --rpc-url … --send` run once on the wallet.
#   4. LIVE_TRADING_ENABLED=1 (this file).
#   5. `--live` flag added to ExecStart in rust-agent-daemon.service.
#   6. Risk gate (RISK_MAX_ORDER_USD) lets the order through; no ./KILL
#      file present.
# Drop any one and the system stays on paper.
#POLYMARKET_PRIVATE_KEY=0x...
#LIVE_TRADING_ENABLED=1

# ---- Risk gate ----
# Hard cap on per-order USD size (default $50). Lower this when you
# first switch to live. Kill switch path is checked before every order
# — `touch ~/workHard/KILL` to immediately halt all order routing.
#RISK_MAX_ORDER_USD=50
#RISK_KILL_PATH=/home/paul/workHard/KILL

# ---- Ingest watchdog ----
# Auto-restart the binance / polymarket ingest workers when their
# data freshness probe shows the newest row is older than this many
# seconds. Covers stuck WS connections where the inner reconnect
# loop never fires because the OS sees the socket as alive. 0
# disables auto-restart (worker still runs; we just don't watch
# it). Default 300 (5 min) — generous enough that a slow market
# segment doesn't churn the worker.
#INGEST_STALE_RESTART_S=300

# ---- Health-status sensitivity ----
# Cache freshness threshold above which /health.status flips to
# "degraded". Mirrors the dashboard's stalest_cache_hint
# threshold so chip + status field stay in sync. 0 = disabled
# (caches still report ages on /health.cache_ages_ms; just
# none of them downgrade status). Default 600 (10 min).
#STALE_CACHE_HEALTH_S=600
# Window during which a recent ingest supervisor restart keeps
# /health.status at "degraded" — a flapping worker stays visible
# to reverse-proxy probes for this many seconds after each
# respawn. 0 = disabled. Default 300 (5 min).
#RECENT_RESTART_S=300

# ---- Dashboard state persistence ----
# The dashboard writes prev_ranks + active sort key to a small
# JSON file after each refresh so a quick restart keeps the Δ
# rank-change indicator + the operator's chosen sort intact.
# Defaults:
#   - DASHBOARD_STATE_PATH = $HOME/.cache/rust-agent/dashboard_state.json
#   - DASHBOARD_STATE_TTL_S = 7200 (2h) — state older than this
#     is treated as a fresh start so Δ indicators don't compare
#     today's ranks against ranks from 2 days ago.
#DASHBOARD_STATE_PATH=/var/lib/rust-agent/dashboard_state.json
#DASHBOARD_STATE_TTL_S=7200

# ---- Rolling-window horizons ----
# Number of UTC bucket_days the rolling-window metrics aggregate
# over. The `days` label on each family reflects the active
# value so Grafana queries against `days="7"` (or your override)
# stay aligned. Both default to 7; 0 / negative / malformed fall
# back to default (a 0-day window would emit nothing).
#AGREEMENT_WINDOW_DAYS=7
#PNL_BREAKDOWN_WINDOW_DAYS=7

# ---- agent_pnl_delta_12h_24h_ratio noise floor (USD) ----
# Strategies with |24h delta| below this floor are skipped from
# the ratio family — near-zero denominators amplify ratios wildly
# and flap alerts. Default $1 is comfortable for paper trading;
# live deployments with larger position sizing want a wider floor
# (e.g. $10) so the metric isn't sensitive to minor execution
# wobble. Set ≤0 to disable the gate (every strategy with both
# deltas present emits a ratio) — useful for debugging the
# pipeline, not recommended for alerting.
#PNL_DELTA_RATIO_DENOM_FLOOR_USD=1

# ---- /metrics cache TTLs ----
# How long the daemon caches each rolled-up read against CoreDB
# before re-querying. Lower = fresher metrics + more CoreDB load;
# higher = less load + staler metrics. Defaults sized for
# Prometheus's default 15s scrape:
#   - decisions / orders: 10s (data ticks every backtest = 30 min)
#   - pnl_daily + breakdown today/yesterday/window: 60s
#     (data ticks when settle-pnl runs = 1h)
#   - ingest probes (btc tick + market freshness): 5s (underlying
#     data ticks every ~500ms; this is more about saving the
#     CoreDB round-trip than freshness)
#METRICS_DECISIONS_CACHE_TTL_S=10
#METRICS_PNL_DAILY_CACHE_TTL_S=60
#INGEST_CACHE_TTL_S=5

# ---- Health endpoint ----
# Port for the /health JSON endpoint exposed when running under
# rust-agent-daemon.service. The unit defaults this to 9099 via
# `Environment=HEALTH_PORT=9099` — set the var here to override
# (e.g. to bind a port that's not blocked by the local firewall, or
# to avoid a collision with another rust-agent instance). The
# listener binds 0.0.0.0; restrict access via a host-level firewall
# rule if you don't want it world-reachable.
#
# To disable the endpoint entirely, edit the unit and drop
# `--health-port ${HEALTH_PORT}` from ExecStart — setting this var
# to empty makes clap fail to parse it at startup.
#HEALTH_PORT=9099
#
# Dashboard auto-config: when HEALTH_PORT is set (or HEALTH_URL
# explicitly below), `rust-agent dashboard` resolves --health-url
# without a CLI flag:
#   1. --health-url <URL> on the CLI (highest priority)
#   2. HEALTH_URL env var (full URL)
#   3. http://127.0.0.1:${HEALTH_PORT}/health (synthesized — matches
#      this unit's default so dashboard launched on the same host
#      gets the chip for free)
# Override only when the daemon's /health lives on a different
# host / path:
#HEALTH_URL=http://example.internal:9099/health

# ---- pdf-kg integration ----
# Set to `disabled` to skip pdf-kg tool registration when that backend
# isn't reachable. Otherwise points at the backend HTTP base URL.
#PDFKG_BACKEND_URL=disabled
